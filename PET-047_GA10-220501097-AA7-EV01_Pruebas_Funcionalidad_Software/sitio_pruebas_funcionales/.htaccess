# Configuración Apache de Producción y Pruebas Funcionales
# Pizzería Gourmet Bella Italia Popayán - Karen Yuliana Campo (Ficha 3186681)

RewriteEngine On

# 1. Forzado de HTTPS (SSL/TLS Let's Encrypt)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Seguridad OWASP Top 10
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# 3. Compresión Gzip para alto rendimiento en redes móviles
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# 4. Prevención de listado de directorios
Options -Indexes
