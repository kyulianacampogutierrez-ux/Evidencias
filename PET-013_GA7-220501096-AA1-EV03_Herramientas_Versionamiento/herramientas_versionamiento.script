frame.create {"rect":[85,473,385,493],"content":"text","text":"2. MATRIZ DIFERENCIAL LOCAL VS REMOTO"}
object.color {"color":"#00A86B","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[75,508,475,693],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"BlueLight"}
object.cornerOptions {"shape":"rounded","size":10}
frame.create {"rect":[90,520,460,544],"content":"text","text":"💻 GIT LOCAL (Máquina del Desarrollador)"}
object.color {"color":"#1D4ED8","text":true}
type.char {"attrs":{"size":13,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[90,548,460,683],"content":"text","text":"• Conectividad: 100% Offline (sin depender de red).\n• Velocidad: Instantánea (< 10 ms por operación en SSD).\n• Almacenamiento: Carpeta interna .git en disco duro local.\n• Alcance: Trabajo individual, ramas experimentales.\n• Riesgo: Alto ante daño de hardware si no hay sincronización."}
object.color {"color":"#334155","text":true}
type.char {"attrs":{"size":11,"fontFamily":"Segoe UI"}}
frame.create {"rect":[495,508,900,693],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"PurpleLight"}
object.cornerOptions {"shape":"rounded","size":10}
frame.create {"rect":[510,520,880,544],"content":"text","text":"☁️ GIT REMOTO (Servidor Nube / GitHub)"}
object.color {"color":"#7C3AED","text":true}
type.char {"attrs":{"size":13,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[510,548,880,683],"content":"text","text":"• Conectividad: Obligatoria por HTTPS o llave SSH.\n• Velocidad: Depende del ancho de banda (~300ms a 2s).\n• Almacenamiento: Servidores georredundantes en la nube.\n• Alcance: Colaboración de equipo, Code Review y PRs.\n• Riesgo: Nulo; disponibilidad 99.95% y backup continuo."}
object.color {"color":"#334155","text":true}
type.char {"attrs":{"size":11,"fontFamily":"Segoe UI"}}
frame.create {"rect":[50,730,920,990],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"CardWhite"}
object.stroke {"swatch":"BorderGray","weight":1.5}
object.cornerOptions {"shape":"rounded","size":14}
frame.create {"rect":[75,748,385,776],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"AmberLight"}
object.cornerOptions {"shape":"rounded","size":6}
frame.create {"rect":[85,753,375,773],"content":"text","text":"3. COMANDOS CLAVE DE GIT LOCAL"}
object.color {"color":"#D97706","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[75,788,330,973],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"CanvasBg"}
object.cornerOptions {"shape":"rounded","size":8}
frame.create {"rect":[85,798,320,820],"content":"text","text":"Gestión de Cambios"}
object.color {"color":"#0F172A","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[85,825,320,960],"content":"text","text":"• git status: Inspecciona área.\n• git add <f> / .: Pasa al stage.\n• git commit -m: Graba snapshot.\n• git diff: Muestra cambios."}
object.color {"color":"#334155","text":true}
type.char {"attrs":{"size":11,"fontFamily":"Segoe UI"}}
frame.create {"rect":[345,788,600,973],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"CanvasBg"}
object.cornerOptions {"shape":"rounded","size":8}
frame.create {"rect":[355,798,590,820],"content":"text","text":"Ramas e Historial"}
object.color {"color":"#0F172A","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[355,825,590,960],"content":"text","text":"• git branch: Lista/crea ramas.\n• git switch <r>: Cambia rama.\n• git merge <r>: Fusiona ramas.\n• git log --oneline: Historial."}
object.color {"color":"#334155","text":true}
type.char {"attrs":{"size":11,"fontFamily":"Segoe UI"}}
frame.create {"rect":[615,788,870,973],"shape":"rectangle","content":"graphic"}
object.fill {"swatch":"CanvasBg"}
object.cornerOptions {"shape":"rounded","size":8}
frame.create {"rect":[625,798,860,820],"content":"text","text":"Auxiliares & Reset"}
object.color {"color":"#0F172A","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[625,825,860,960],"content":"text","text":"• git init: Inicia repositorio.\n• git stash: Guarda temporal.\n• git reset HEAD <f>: Des-indexa.\n• git checkout -- <f>: Deshace."}
object.color {"color":"#334155","text":true}
type.char {"attrs":{"size":11,"fontFamily":"Segoe UI"}}
