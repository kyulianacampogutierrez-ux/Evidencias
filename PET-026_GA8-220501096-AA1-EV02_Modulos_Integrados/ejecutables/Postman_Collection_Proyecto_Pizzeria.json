              "});",
              "pm.test('El catálogo contiene pizzas con precios por tamaño', function () {",
              "    var data = pm.response.json();",
              "    var pizzas = Array.isArray(data) ? data : (data.pizzas || []);",
              "    pm.expect(pizzas).to.be.an('array');",
              "    pm.expect(pizzas.length).to.be.above(0);",
              "    pm.expect(pizzas[0]).to.have.property('precios');",
              "});"
