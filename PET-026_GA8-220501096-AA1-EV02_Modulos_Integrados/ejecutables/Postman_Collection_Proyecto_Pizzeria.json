    {
      "name": "03. Auth - Login Cliente y Captura Dinámica de JWT",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario_cliente}}\",\n  \"password\": \"{{password_cliente}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna token JWT válido y almacena en variables', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.token).to.be.a('string');",
              "    pm.collectionVariables.set('jwt_token_cliente', data.token);",
              "    pm.environment.set('jwt_token_cliente', data.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
