      "name": "01. Sistema - Healthcheck General",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('El microservicio reporta estado UP', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.status).to.eql('UP');",
              "    pm.expect(data.database).to.include('MongoDB');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
