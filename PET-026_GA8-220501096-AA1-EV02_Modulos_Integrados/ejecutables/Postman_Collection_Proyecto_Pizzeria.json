          { "key": "Authorization", "value": "Bearer {{jwt_token_cliente}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"pizzaCodigo\": \"PIZ-MARG-01\",\n      \"tamano\": \"familiar\",\n      \"precioUnitario\": 48000.0,\n      \"cantidad\": 1\n    }\n  ],\n  \"cuponCodigo\": \"SENA2026\",\n  \"direccionEnvio\": \"Calle 5 # 4-22, Popayán\",\n  \"metodoPago\": \"NEQUI\"\n}"
        },
