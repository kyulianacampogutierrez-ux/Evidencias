Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64" # Ubuntu Server 22.04 LTS
  config.vm.hostname = "sena-vm-cliente-pizzeria"

  # Redirección de Puertos
  config.vm.network "forwarded_port", guest: 80, host: 8092, auto_correct: true
  config.vm.network "forwarded_port", guest: 3306, host: 3309, auto_correct: true

  # Red Privada Host-Only
  config.vm.network "private_network", ip: "192.168.56.110"

  # Asignación de Recursos de Hardware Virtualizado (VirtualBox / KVM)
  config.vm.provider "virtualbox" do |vb|
    vb.name = "VM-Ubuntu-LAMP-Pizzeria-KarenCampo"
    vb.memory = "2048" # 2 GB de RAM estática asignada
    vb.cpus = 2        # 2 núcleos vCPU
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  # Aprovisionamiento Automatizado
  config.vm.provision "shell", path: "provision_vm_ubuntu_lamp.sh"
end
