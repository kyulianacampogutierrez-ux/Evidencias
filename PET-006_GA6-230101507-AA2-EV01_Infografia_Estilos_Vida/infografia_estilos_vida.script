object.color {"color":"#EFF6FF","text":true}
type.char {"attrs":{"size":9,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
type.para {"attrs":{"align":"center"}}
frame.create {"rect":[200,1475,575,1495],"content":"text","text":"3. SILLA ERGONÓMICA Y ZONA LUMBAR"}
object.color {"color":"#0369A1","text":true}
type.char {"attrs":{"size":12,"fontFamily":"Segoe UI","fontStyle":"Bold"}}
frame.create {"rect":[200,1500,575,1570],"content":"text","text":"• Soporte lumbar activo ajustado a la lordosis anatómica (L1 a L5).\n• Borde anterior redondeado para no estrangular circulación venosa."}
object.color {"color":"#0F172A","text":true}
type.char {"attrs":{"size":10,"fontFamily":"Segoe UI","fontStyle":"Regular"}}
frame.create {"rect":[610,1460,1140,1580],"shape":"rectangle","content":"graphic"}
